# ── App ──────────────────────────────────────────────────────────────
PORT=3030
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/task-management-app?schema=public"

# ── JWT ──────────────────────────────────────────────────────────────
# REQUIRED: at least 32 chars, generated with: openssl rand -hex 64
JWT_SECRET=change_me_to_a_strong_random_secret_min_32_chars
JWT_EXPIRES_IN=15m

# REQUIRED: different from JWT_SECRET, also at least 32 chars
JWT_REFRESH_SECRET=change_me_to_a_different_strong_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=   # uncomment if your Redis requires auth

# ── Mail (SMTP) ───────────────────────────────────────────────────────
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=your_mailtrap_user
MAIL_PASS=your_mailtrap_pass
MAIL_FROM=noreply@example.com

# ── Security / CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed origins. Empty = deny all cross-origin requests.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Maximum request body size (prevents payload DoS)
BODY_LIMIT=1mb

# Public app URL — used when building links in verification/reset emails
APP_URL=http://localhost:3030

# ── Rate limiting ─────────────────────────────────────────────────────
THROTTLE_TTL=60        # window in seconds
THROTTLE_LIMIT=100     # max requests per window per IP (global default)

# ── Account lockout ───────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5   # consecutive failures before lockout
LOCKOUT_MINUTES=15     # lockout duration
