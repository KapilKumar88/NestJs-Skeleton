# ── App ──────────────────────────────────────────────────────────────
PORT=3030
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/task-management-app?schema=public"

# ── JWT ──────────────────────────────────────────────────────────────
# REQUIRED: set a strong random secret (e.g. openssl rand -hex 64)
JWT_SECRET=change_me_to_a_strong_random_secret
JWT_EXPIRES_IN=15m

# REQUIRED: different from JWT_SECRET
JWT_REFRESH_SECRET=change_me_to_a_different_strong_secret
JWT_REFRESH_EXPIRES_IN=7d

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=   # uncomment if your Redis requires auth

# ── Mail (SMTP) ───────────────────────────────────────────────────────
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=your_mailtrap_user
MAIL_PASS=your_mailtrap_pass
MAIL_FROM=noreply@example.com
